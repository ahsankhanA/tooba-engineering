# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# TOOBA ENGINEERING BACKEND CONFIGURATION (ZERO-COST INFRASTRUCTURE)
# ==============================================================================

# MONGODB_URI: MongoDB Atlas Free Tier (M0 Sandbox) connection string.
# Purpose: Persistent data storage for users, catalog, orders, credentials, and audit logs.
# Free/Paid: 100% Free (512MB shared cluster, no credit card required).
# Obtain from: https://cloud.mongodb.com -> Database -> Connect -> Drivers
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tooba_db?retryWrites=true&w=majority&appName=Cluster0"

# JWT_SECRET: Cryptographic secret key for signing authentication tokens.
# Purpose: Secures HttpOnly session cookies. Must be minimum 32-64 random characters.
# Free/Paid: Free (Generated locally: e.g. `openssl rand -base64 48`).
JWT_SECRET="replace_with_a_secure_high_entropy_random_64_character_string_here"

# JWT_EXPIRES_IN: Token validity duration.
# Purpose: Prevents perpetual sessions; defaults to 8 hours for operational security.
JWT_EXPIRES_IN="8h"

# NODE_ENV: Application environment mode ("development" | "production").
NODE_ENV="development"

# CORS_ORIGIN: Comma-separated list of allowed frontend origins.
# In development: "http://localhost:3000"
# In production on Render/Vercel: "https://tooba-engineering.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# WHATSAPP_BUSINESS_PHONE: Official Tooba Engineering WhatsApp number in international format without plus or spaces.
# Purpose: Click-to-chat deep linking for quote inquiries and direct customer consultations (100% Free).
WHATSAPP_BUSINESS_PHONE="923001234567"

